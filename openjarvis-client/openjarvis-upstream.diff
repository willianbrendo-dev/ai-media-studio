@@ -412,6 +412,83 @@ class OrchestratorAgent(ToolUsingAgent):
     # Function-calling mode (original behaviour)
     # ------------------------------------------------------------------
 
+    def _select_openai_tools(
+        self,
+        input_text: str,
+        context: Optional[AgentContext] = None,
+    ) -> list[dict[str, Any]]:
+        """Filter OpenAI tool schemas dynamically by intent to prevent bulk MCP token exhaustion."""
+        if not self._tools:
+            return []
+        all_tools = self._executor.get_openai_tools()
+        if not all_tools:
+            return []
+
+        if context is not None and context.tools:
+            if context.tools == ["__none__"]:
+                return []
+            allowed_ctx = set(context.tools)
+            return [
+                t for t in all_tools
+                if (t.get("function") or {}).get("name") in allowed_ctx
+            ]
+
+        all_names = {
+            (t.get("function") or {}).get("name", "")
+            for t in all_tools
+        }
+        has_ecosystem_mcp = any(
+            n.startswith(("desktop_", "studio_")) or n == "webcam_look"
+            for n in all_names
+        )
+        if not has_ecosystem_mcp:
+            return all_tools
+
+        low = (input_text or "").lower()
+        selected_names: set[str] = set()
+
+        vision_kw = (
+            "câmera", "camera", "webcam", "webicão", "webicao",
+            "segurando", "mostrando", "olhe", "olha", "vendo",
+            "veja o que", "identifique",
+        )
+        desktop_kw = (
+            "chrome", "navegador", "browser", "aba", "guia", "shopee",
+            "chopia", "shopi", "afiliado", "filhado", "site", "url",
+            "link", "janela", "tela", "clica", "clicar", "clique",
+            "digita", "digitar", "tecla", "atalho", "desktop",
+            "abrir", "abra", "abre", "youtube",
+        )
+        studio_kw = (
+            "stack", "container", "contêiner", "conteiner", "docker",
+            "estúdio", "estudio", "moneyprinter", "supoclip",
+            "openfilm", "voicestudio", "openseo", "agenttube", "higgsfield",
+            "cascata", "cascade", "status", "log", "modo dev", "modo-dev",
+            "skill", "ligar", "ligue", "liga", "desligar", "desligue",
+            "desliga", "iniciar", "inicie", "parar", "pare", "reiniciar",
+            "reinicie", "job", " via api", " pela api",
+            "vps", "nuvem", "cloud", "servidor", "remoto", "remota",
+            "saída", "saidas", "galeria", "download", "baixar",
+        )
+
+        if any(k in low for k in vision_kw):
+            selected_names.add("webcam_look")
+        if any(k in low for k in desktop_kw):
+            selected_names.add("studio_open_url")
+            selected_names.update(n for n in all_names if n.startswith("desktop_"))
+        if any(k in low for k in studio_kw) or ("painel" in low and "afiliad" not in low and "shopee" not in low):
+            selected_names.update(
+                n for n in all_names if n.startswith("studio_") and n != "studio_open_url"
+            )
+
+        if not selected_names:
+            return []
+
+        return [
+            t for t in all_tools
+            if (t.get("function") or {}).get("name") in selected_names
+        ]
+
     def _run_function_calling(
         self,
         input: str,
@@ -427,8 +504,8 @@ class OrchestratorAgent(ToolUsingAgent):
             system_prompt=self._system_prompt,
         )
 
-        # Get OpenAI-format tool definitions
